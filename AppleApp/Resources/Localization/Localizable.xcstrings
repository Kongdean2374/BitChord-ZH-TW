    "Bluetooth": {},
    "Bring your library, playlists and mixes with you, and start a Listen Together party with friends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring deine Mediathek, Playlists und Mixe mit und starte eine Gemeinsam-hören-Party mit Freunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae contigo tu biblioteca, listas y mixes, y empieza una sesión de Escuchar juntos con tus amigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez votre bibliothèque, vos playlists et vos mix, et lancez une soirée Écoute partagée avec vos amis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הביאו איתכם את הספרייה, הפלייליסטים והמיקסים, והתחילו מסיבת האזנה משותפת עם חברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी, प्लेलिस्ट और मिक्स साथ लाएँ, और दोस्तों के साथ साथ सुनें पार्टी शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa pustaka, playlist, dan mix Anda, lalu mulai sesi Dengarkan Bersama dengan teman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta con te libreria, playlist e mix e avvia una sessione di Ascolto condiviso con gli amici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ、プレイリスト、ミックスを引き継いで、友だちといっしょに聴くパーティーを始めましょう。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabierz ze sobą bibliotekę, playlisty i miksy oraz rozpocznij Wspólne słuchanie ze znajomymi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve sua biblioteca, playlists e mixes com você e comece uma sessão de Ouvir juntos com seus amigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите свою библиотеку, плейлисты и миксы и устройте сессию «Слушать вместе» с друзьями."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำคลัง เพลย์ลิสต์ และมิกซ์ของคุณมาด้วย แล้วเริ่มปาร์ตี้ฟังด้วยกันกับเพื่อน ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınızı, çalma listelerinizi ve miksleri yanınızda taşıyın, arkadaşlarınızla Birlikte Dinle oturumu başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mang theo thư viện, danh sách phát và mix của bạn, rồi bắt đầu buổi Nghe cùng nhau với bạn bè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带上你的音乐库、播放列表和合辑，与好友开启“一起听”派对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶上你的音樂庫、播放清單和合輯，與好友開啟「一起聽」派對。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "帶上你的音樂庫、播放清單和合輯，與好友開啟「一起聽」派對。"
          }
        }
      }
    },
